+package com.ronin.vanta;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Extracts "which file, which line" facts from build output.
+ *
+ * Replacement body for ForgeCodeDiagnostics.errors(String). The original only
+ * recognised compiler lines of the form  app/...:LINE: message, so three kinds
+ * of failure produced an empty map and AgenticRepair threw
+ * AGENTIC_REPAIR_NO_TARGET even though the bad file was named in the log:
+ *
+ *  1. Vanta's own source preflight ("path: invalid XML — ...", no line number).
+ *     JobOperations passes that report straight into AgenticRepair.author as
+ *     the diagnostics, so EVERY preflight-triggered repair hit NO_TARGET.
+ *  2. Root build files (settings.gradle, build.gradle, gradle.properties) —
+ *     the old pattern required an app/ or src/ prefix.
+ *  3. Gradle script failures, which Gradle reports as
+ *     "Build file '/…/app/build.gradle' line: 12" or Groovy's
+ *     "settings file '/…/settings.gradle': 1: unexpected token …".
+ */
+final class ForgeDiagnosticPatterns {
+
+    private ForgeDiagnosticPatterns() {
+    }
+
+    static final String PREFLIGHT_MARKER = "VANTA SOURCE PREFLIGHT";
+
+    private static final String PROJECT_PATH =
+            "(?:(?:app|src)/[^\\r\\n:'\"]+\\.(?:kt|java|xml|gradle(?:\\.kts)?|properties|pro)"
+                    + "|(?:settings|build)\\.gradle(?:\\.kts)?|gradle\\.properties)";
+
+    /** Original FILE_ERROR, widened to root build files, .properties and proguard rules. */
+    static final Pattern FILE_ERROR = Pattern.compile(
+            "(?m)^(?:e:\\s*)?(?:(?:file://)?[^\\r\\n]*?/project/)?(" + PROJECT_PATH + "):"
+                    + "\\s*(?:\\((\\d+),\\s*(\\d+)\\)|(?:\\s*(\\d+)(?::(\\d+))?)):?\\s*([^\\r\\n]+)$");
+
+    /** Vanta preflight lines: "path: message" or "path:line[:col]: message". Only applied to preflight reports. */
+    static final Pattern PREFLIGHT_ERROR = Pattern.compile(
+            "(?m)^(" + PROJECT_PATH + ")(?::(\\d+)(?::(\\d+))?)?:\\s+([^\\r\\n]+)$");
+
+    /** Gradle "* Where:" block and Groovy script compile errors. */
+    static final Pattern GRADLE_SCRIPT = Pattern.compile(
+            "(?mi)^\\s*(?:build|settings|script) file '([^'\\r\\n]+?\\.gradle(?:\\.kts)?)'"
+                    + "(?:\\s+line:\\s*(\\d+)|:\\s*(\\d+):\\s*([^\\r\\n]+))");
+
+    private static final Pattern PARSER_POSITION = Pattern.compile("@(\\d+):(\\d+)\\s+in\\s+java\\.io\\.StringReader");
+    private static final Pattern WHAT_WENT_WRONG = Pattern.compile("\\* What went wrong:\\s*\\r?\\n\\s*([^\\r\\n]+)");
+    private static final Pattern ROOT_RELATIVE = Pattern.compile(
+            "(?:^|/)((?:app|src)/.+|(?:settings|build)\\.gradle(?:\\.kts)?|gradle\\.properties)$");
+
+    static LinkedHashMap<String, List<String>> errors(String log) {
+        LinkedHashMap<String, List<String>> out = new LinkedHashMap<>();
+        if (log == null) {
+            return out;
+        }
+        String clean = log.replaceAll("\\x1B\\[[0-9;]*[a-zA-Z]", "");
+
+        Matcher m = FILE_ERROR.matcher(clean);
+        while (m.find() && out.size() <= 150) {
+            String line = m.group(2) == null ? m.group(4) : m.group(2);
+            String col = m.group(3) == null ? m.group(5) : m.group(3);
+            add(out, m.group(1), line, col, m.group(6));
+        }
+
+        if (clean.contains(PREFLIGHT_MARKER)) {
+            Matcher p = PREFLIGHT_ERROR.matcher(clean);
+            while (p.find() && out.size() <= 150) {
+                String line = p.group(2);
+                String col = p.group(3);
+                if (line == null) {
+                    // Android's XmlPullParser reports "(position:… @27:1 in java.io.StringReader@…)".
+                    Matcher at = PARSER_POSITION.matcher(p.group(4));
+                    if (at.find()) {
+                        line = at.group(1);
+                        col = at.group(2);
+                    }
+                }
+                add(out, p.group(1), line == null ? "1" : line, col, p.group(4));
+            }
+        }
+
+        Matcher g = GRADLE_SCRIPT.matcher(clean);
+        Matcher why = WHAT_WENT_WRONG.matcher(clean);
+        String reason = why.find() ? why.group(1).trim() : "Gradle could not evaluate this build script (see full log)";
+        while (g.find() && out.size() <= 150) {
+            String path = relative(g.group(1));
+            if (path == null) {
+                continue;
+            }
+            String line = g.group(2) != null ? g.group(2) : g.group(3);
+            String detail = g.group(4) != null ? g.group(4) : reason;
+            add(out, path, line, null, detail);
+        }
+        return out;
+    }
+
+    /** "/home/runner/work/x/x/project/app/build.gradle" → "app/build.gradle"; null when not a project file. */
+    static String relative(String absolute) {
+        String p = absolute.replace('\\', '/');
+        int project = p.lastIndexOf("/project/");
+        if (project >= 0) {
+            p = p.substring(project + "/project/".length());
+        }
+        Matcher m = ROOT_RELATIVE.matcher(p);
+        if (!m.find()) {
+            return null;
+        }
+        String rel = m.group(1);
+        int app = rel.indexOf("app/");
+        return app > 0 && rel.substring(0, app).endsWith("/") ? rel.substring(app) : rel;
+    }
+
+    private static void add(LinkedHashMap<String, List<String>> out, String path, String line, String col, String detail) {
+        String value = path + ":" + (line == null ? "1" : line) + (col == null ? "" : ":" + col) + ": " + Errors.redact(detail.trim());
+        List<String> group = out.computeIfAbsent(path, k -> new ArrayList<>());
+        if (!group.contains(value) && group.size() < 250) {
+            group.add(value);
+        }
+    }
+}
