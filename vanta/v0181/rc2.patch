+package com.ronin.vanta;
+
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import javax.xml.parsers.DocumentBuilder;
+import javax.xml.parsers.DocumentBuilderFactory;
+import org.xml.sax.InputSource;
+import org.xml.sax.SAXException;
+import org.xml.sax.SAXParseException;
+import org.xml.sax.helpers.DefaultHandler;
+
+/**
+ * Checks that AI-written file contents actually belong at their target path.
+ *
+ * Small models given a multi-file context often answer with several files
+ * glued together: markdown fences, "// app/build.gradle" style path headers,
+ * Vanta's own "--- path ---" context separators, or simply the wrong file
+ * (Gradle text in App.java, a dimens.xml in settings.gradle). Nothing between
+ * ForgeAuthor.writeFile and the compiler checked for that, so garbage reached
+ * the build and the repair agent had no file/line to work from.
+ *
+ * Every finding carries a line number so the result can be fed back through
+ * ForgeCodeDiagnostics / AgenticRepair.targets as a normal "path:line: msg".
+ */
+final class ForgeSourceGuard {
+
+    private ForgeSourceGuard() {
+    }
+
+    static final class Finding {
+        final int line;
+        final String message;
+
+        Finding(int line, String message) {
+            this.line = Math.max(1, line);
+            this.message = message;
+        }
+    }
+
+    private static final String CODE_EXT = "(?:java|kt|kts|xml|gradle|properties|pro|json)";
+
+    /** A line consisting only of a file path, optionally behind a comment marker or a label. */
+    private static final Pattern PATH_LINE = Pattern.compile(
+            "^\\s*(//+|#|<!--|/\\*+)?\\s*((?:SOURCE FILE|WRITE EXACTLY THIS FILE|FILE)\\s*:?\\s*)?"
+                    + "((?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\." + CODE_EXT + ")"
+                    + "\\s*(?:-->|\\*/)?\\s*$");
+
+    /** Vanta's own context separator from ForgeAuthor.context(), echoed back by the model. */
+    private static final Pattern CONTEXT_HEADER = Pattern.compile(
+            "^\\s*---\\s+(?:DEPENDENCY EXCERPT[^:]*:\\s*)?(\\S+)\\s+---\\s*$");
+
+    private static final Pattern FENCE = Pattern.compile("^\\s*```");
+    private static final Pattern JAVA_PACKAGE = Pattern.compile("^\\s*package\\s+([A-Za-z_][\\w.]*)\\s*;");
+    private static final Pattern JAVA_PACKAGE_LINE = Pattern.compile("(?m)^\\s*package\\s+[A-Za-z_][\\w.]*\\s*;\\s*$");
+    private static final Pattern XML_IN_SCRIPT = Pattern.compile("(?m)^\\s*<(?:\\?xml|resources\\b|manifest\\b|vector\\b|adaptive-icon\\b|[A-Z][\\w.]*Layout\\b)");
+    /** Top-level (unindented) public type; Java requires its name to equal the file name. */
+    private static final Pattern PUBLIC_TYPE = Pattern.compile(
+            "(?m)^public\\s+(?:(?:final|abstract|sealed|non-sealed|strictfp)\\s+)*(?:class|interface|enum|record|@interface)\\s+([A-Za-z_]\\w*)");
+    private static final Pattern INCLUDES_APP = Pattern.compile("include\\s*\\(?\\s*(?:['\"][^'\"\\n]*['\"]\\s*,\\s*)*['\"]:app['\"]");
+
+    /** File types this guard knows how to check. Anything else (README.md, images) is left alone. */
+    static boolean checked(String path) {
+        String p = path == null ? "" : path.toLowerCase(Locale.ROOT);
+        return p.endsWith(".java") || p.endsWith(".kt") || p.endsWith(".xml") || p.endsWith(".gradle")
+                || p.endsWith(".gradle.kts") || p.endsWith(".properties") || p.endsWith(".pro");
+    }
+
+    /** All findings for one file, including a full XML parse for .xml files. */
+    static List<Finding> inspect(String path, String content) {
+        return inspect(path, content, true);
+    }
+
+    /**
+     * @param parseXml false when the caller (AndroidProjectCheck) already parses XML itself,
+     *                 so the same XML error is not reported twice.
+     */
+    static List<Finding> inspect(String path, String content, boolean parseXml) {
+        if (!checked(path) || content == null) {
+            return Collections.emptyList();
+        }
+        List<Finding> out = new ArrayList<>();
+        String text = content.startsWith("\ufeff") ? content.substring(1) : content;
+        String lower = path.toLowerCase(Locale.ROOT);
+        String[] lines = text.split("\r?\n", -1);
+
+        for (int i = 0; i < lines.length && out.size() < 20; i++) {
+            String line = lines[i];
+            int n = i + 1;
+            if (FENCE.matcher(line).find()) {
+                out.add(new Finding(n, "markdown code fence (```) in source — the model wrapped or concatenated files"));
+                continue;
+            }
+            Matcher header = CONTEXT_HEADER.matcher(line);
+            if (header.matches()) {
+                out.add(new Finding(n, "Vanta context separator for " + header.group(1) + " copied into this file"));
+                continue;
+            }
+            Matcher m = PATH_LINE.matcher(line);
+            if (m.matches()) {
+                boolean comment = m.group(1) != null;
+                boolean labelled = m.group(2) != null;
+                String named = m.group(3);
+                boolean self = sameFile(path, named);
+                // `j.json` or `job.json` at the start of a Java/Kotlin line can be
+                // ordinary field access, not a pasted filename. Only flag
+                // unambiguous paths or explicit file labels here.
+                if (!comment && (labelled || named.contains("/") || buildFile(named))) {
+                    out.add(new Finding(n, "bare file path '" + named + "' as a line of source"
+                            + (self ? "" : " — content for another file was merged in here")));
+                } else if (!self && comment && (labelled || named.contains("/") || buildFile(named))) {
+                    out.add(new Finding(n, "header for another file (" + named + ") — content for another file was merged in here"));
+                } else if (self && labelled) {
+                    out.add(new Finding(n, "model instruction label copied into source"));
+                }
+            }
+        }
+
+        if (lower.endsWith(".xml") && parseXml) {
+            Finding xmlError = xmlCheck(text);
+            if (xmlError != null) {
+                out.add(xmlError);
+            }
+        }
+
+        if (lower.endsWith(".java")) {
+            javaChecks(path, text, out);
+        }
+
+        if (lower.endsWith(".gradle") || lower.endsWith(".gradle.kts")) {
+            Matcher xml = XML_IN_SCRIPT.matcher(text);
+            if (xml.find()) {
+                out.add(new Finding(lineOf(text, xml.start()), "XML found in a Gradle script — this is resource/manifest content, not build configuration"));
+            }
+            Matcher pkg = JAVA_PACKAGE_LINE.matcher(text);
+            if (pkg.find()) {
+                out.add(new Finding(lineOf(text, pkg.start()), "Java source found in a Gradle script"));
+            }
+            String name = lower.contains("/") ? lower.substring(lower.lastIndexOf('/') + 1) : lower;
+            if ((name.equals("settings.gradle") || name.equals("settings.gradle.kts")) && !lower.contains("/")
+                    && !INCLUDES_APP.matcher(stripComments(text)).find()) {
+                out.add(new Finding(1, "settings script does not include the ':app' module"));
+            }
+        }
+        return out;
+    }
+
+    /** "path:line: message" strings, the format ForgeCodeDiagnostics turns into repair targets. */
+    static List<String> findings(String path, String content, boolean parseXml) {
+        List<String> out = new ArrayList<>();
+        for (Finding f : inspect(path, content, parseXml)) {
+            out.add(path + ":" + f.line + ": " + f.message);
+        }
+        return out;
+    }
+
+    /**
+     * Call immediately after ForgeAuthor.writeFile and BEFORE documents.put(record, file).
+     * A rejected file is not saved; its chunks are listed for discard and the
+     * existing INVALID_OUTPUT recovery hands the file to another model.
+     */
+    static void requireClean(String path, String content, String record) throws ForgeRecovery.InvalidOutput {
+        List<Finding> found = inspect(path, content, true);
+        if (found.isEmpty()) {
+            return;
+        }
+        StringBuilder why = new StringBuilder();
+        for (int i = 0; i < found.size() && i < 3; i++) {
+            why.append(i == 0 ? "" : "; ").append("line ").append(found.get(i).line).append(": ").append(found.get(i).message);
+        }
+        if (found.size() > 3) {
+            why.append("; +").append(found.size() - 3).append(" more");
+        }
+        throw new ForgeRecovery.InvalidOutput(
+                "AUTHORED_FILE_REJECTED: the model's output for " + path + " is not a valid " + kind(path)
+                        + " file (" + why + "). It was not saved; completed files are kept and this file will be rewritten by another model.",
+                records(record), null);
+    }
+
+    /** Every saved document belonging to one authored file, mirroring ForgeOutputRecovery.invalidRepairRecords. */
+    static List<String> records(String record) {
+        List<String> keys = new ArrayList<>();
+        keys.add(record);
+        for (int part = 0; part < 4; part++) {
+            keys.add(record + "_chunk_" + part);
+            String phase = record + "_part_" + part;
+            keys.add(phase);
+            keys.add(phase + "_output_limit");
+            keys.add(phase + "_expanded_1");
+            keys.add(phase + "_expanded_1_output_limit");
+        }
+        return keys;
+    }
+
+    /** Preflight wording for an XML parse failure, with the parser's line/column so repair can target it. */
+    static String xmlFailure(String path, Exception failure, String cleanedMessage) {
+        if (failure instanceof SAXParseException) {
+            SAXParseException sax = (SAXParseException) failure;
+            int line = Math.max(1, sax.getLineNumber());
+            int col = Math.max(1, sax.getColumnNumber());
+            return path + ":" + line + ":" + col + ": invalid XML — " + cleanedMessage;
+        }
+        return path + ":1: invalid XML — " + cleanedMessage;
+    }
+
+    // ---------------------------------------------------------------- helpers
+
+    private static void javaChecks(String path, String text, List<Finding> out) {
+        String body = stripComments(text);
+        Matcher pkg = JAVA_PACKAGE.matcher(body.replaceFirst("\\A\\s+", ""));
+        String expected = expectedPackage(path);
+        if (!pkg.find()) {
+            if (expected != null) {
+                out.add(new Finding(1, "not Java source — no 'package " + expected + ";' declaration at the top"));
+            }
+            return;
+        }
+        if (expected != null && !expected.equals(pkg.group(1))) {
+            out.add(new Finding(lineOf(text, Math.max(0, text.indexOf("package"))),
+                    "declares package " + pkg.group(1) + " but the file lives in " + expected));
+        }
+        Matcher xml = XML_IN_SCRIPT.matcher(text);
+        if (xml.find()) {
+            out.add(new Finding(lineOf(text, xml.start()), "XML found in a Java source file"));
+        }
+        String stem = path.substring(path.lastIndexOf('/') + 1).replaceFirst("\\.java$", "");
+        Matcher type = PUBLIC_TYPE.matcher(body);
+        while (type.find()) {
+            if (!type.group(1).equals(stem)) {
+                out.add(new Finding(lineOf(body, type.start()), "public type " + type.group(1)
+                        + " cannot live in " + stem + ".java — this is another file's content"));
+                break;
+            }
+        }
+        Matcher second = JAVA_PACKAGE_LINE.matcher(text);
+        if (second.find() && second.find()) {
+            out.add(new Finding(lineOf(text, second.start()), "second package declaration — another Java file was merged in here"));
+        }
+    }
+
+    /** com.example.foo for app/src/main/java/com/example/foo/Bar.java; null when not under a java/ source root. */
+    static String expectedPackage(String path) {
+        Matcher m = Pattern.compile("(?:^|/)src/[^/]+/java/(.+)/[^/]+\\.java$").matcher(path);
+        return m.find() ? m.group(1).replace('/', '.') : null;
+    }
+
+    private static boolean sameFile(String target, String named) {
+        String t = target.replace('\\', '/');
+        String n = named.replace('\\', '/');
+        return t.equals(n) || t.endsWith("/" + n) || n.endsWith("/" + t);
+    }
+
+    private static boolean buildFile(String name) {
+        String n = name.toLowerCase(Locale.ROOT);
+        return n.equals("settings.gradle") || n.equals("settings.gradle.kts") || n.equals("build.gradle")
+                || n.equals("build.gradle.kts") || n.equals("gradle.properties") || n.equals("androidmanifest.xml")
+                || n.equals("proguard-rules.pro");
+    }
+
+    private static String kind(String path) {
+        String p = path.toLowerCase(Locale.ROOT);
+        if (p.endsWith(".gradle") || p.endsWith(".gradle.kts")) return "Gradle";
+        if (p.endsWith(".xml")) return "XML";
+        if (p.endsWith(".java")) return "Java";
+        if (p.endsWith(".kt")) return "Kotlin";
+        return "source";
+    }
+
+    private static String stripComments(String text) {
+        StringBuilder out = new StringBuilder(text.length());
+        Matcher m = Pattern.compile("(?s)/\\*.*?\\*/").matcher(text);
+        int last = 0;
+        while (m.find()) {
+            out.append(text, last, m.start());
+            String block = m.group();
+            for (int i = 0; i < block.length(); i++) {
+                if (block.charAt(i) == '\n') out.append('\n');
+            }
+            last = m.end();
+        }
+        out.append(text.substring(last));
+        return out.toString().replaceAll("(?m)^\\s*//.*$", "");
+    }
+
+    private static int lineOf(String text, int offset) {
+        int line = 1;
+        for (int i = 0; i < offset && i < text.length(); i++) {
+            if (text.charAt(i) == '\n') line++;
+        }
+        return line;
+    }
+
+    /** Same parser settings as AndroidProjectCheck.parse; null when the XML is well-formed. */
+    private static Finding xmlCheck(String text) {
+        try {
+            Matcher doctype = Pattern.compile("<!\\s*(DOCTYPE|ENTITY)", Pattern.CASE_INSENSITIVE).matcher(text);
+            if (doctype.find()) {
+                return new Finding(lineOf(text, doctype.start()), "document type/entity declarations are not permitted in Android resource XML");
+            }
+            DocumentBuilderFactory f = DocumentBuilderFactory.newInstance();
+            f.setNamespaceAware(true);
+            f.setExpandEntityReferences(false);
+            DocumentBuilder b = f.newDocumentBuilder();
+            b.setEntityResolver((publicId, systemId) -> {
+                throw new SAXException("External XML references are disabled");
+            });
+            b.setErrorHandler(new DefaultHandler() {
+                @Override
+                public void error(SAXParseException e) throws SAXException {
+                    throw e;
+                }
+
+                @Override
+                public void fatalError(SAXParseException e) throws SAXException {
+                    throw e;
+                }
+            });
+            b.parse(new InputSource(new StringReader(text)));
+            return null;
+        } catch (SAXParseException e) {
+            return new Finding(e.getLineNumber(), "invalid XML — " + String.valueOf(e.getMessage()).replace('\n', ' '));
+        } catch (Exception e) {
+            return new Finding(1, "invalid XML — " + String.valueOf(e.getMessage()).replace('\n', ' '));
+        }
+    }
+}
