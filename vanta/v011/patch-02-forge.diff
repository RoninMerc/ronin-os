+  private static JSONObject stageSourceBundle(
+      JobEngine e, VantaJob j, JSONObject project, Net.Call call) throws Exception {
+    SourceProject.validate(project);
+    String fingerprint = ProjectArchive.fingerprint(project);
+    JSONObject previous = e.store.document(j.id(), "source_bundle");
+    if (previous != null && fingerprint.equals(previous.optString("fingerprint"))) return previous;
+    byte[] bytes = SourceProject.zip(project);
+    call.check();
+    String mediaId = j.id() + "-source";
+    new JobFiles(e.context).save(mediaId, bytes);
+    String name = "Forge-" + j.id() + "-source.zip";
+    Uri uri = null;
+    if (previous != null && !previous.optString("uri").isEmpty()) {
+      try {
+        uri = Uri.parse(previous.getString("uri"));
+        try (OutputStream out = e.context.getContentResolver().openOutputStream(uri, "rwt")) {
+          if (out == null) throw new IOException("Saved source destination is unavailable");
+          out.write(bytes);
+          out.flush();
+        }
+      } catch (Exception unavailable) {
+        uri = null;
+      }
+    }
+    if (uri == null) {
+      uri = saveShared(e.context, bytes, name, "application/zip");
+      new OutputLibrary(e.context)
+          .add(uri, name, "application/zip", bytes.length, "Forge source");
+    }
+    JSONObject bundle =
+        new JSONObject()
+            .put("uri", uri.toString())
+            .put("name", name)
+            .put("mime", "application/zip")
+            .put("bytes", bytes.length)
+            .put("media_id", mediaId)
+            .put("fingerprint", fingerprint);
+    j.json.put("source_bundle_uri", uri.toString()).put("source_bundle_name", name);
+    e.store.checkpoint(j, "source_bundle", bundle);
+    e.event(
+        j,
+        "source_bundle_ready",
+        "RUNNING",
+        ProgressState.transition(
+            j.progress(), "SOURCE READY", "Source ZIP saved. APK compilation continues separately."));
+    e.store.save(j);
+    return bundle;
+  }
