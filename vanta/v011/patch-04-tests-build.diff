--- a/app/src/test/java/com/ronin/vanta/UnifiedRouting011Test.java
+++ b/app/src/test/java/com/ronin/vanta/UnifiedRouting011Test.java
@@ -0,0 +1,30 @@
+package com.ronin.vanta;
+
+import static org.junit.Assert.*;
+import java.nio.file.*;
+import org.junit.Test;
+
+public class UnifiedRouting011Test {
+  @Test public void sourceContainsSafeAutomaticHandoverAndPortableBundle() throws Exception {
+    String engine = Files.readString(Paths.get("src/main/java/com/ronin/vanta/JobEngine.java"));
+    String recovery = Files.readString(Paths.get("src/main/java/com/ronin/vanta/UnifiedRecoveryController.java"));
+    String operations = Files.readString(Paths.get("src/main/java/com/ronin/vanta/JobOperations.java"));
+    assertTrue(engine.contains("UnifiedRecoveryController.recover"));
+    assertTrue(recovery.contains("ChatProtocol.Refused"));
+    assertTrue(recovery.contains("ForgeRecovery.refusal"));
+    assertTrue(recovery.contains("automatic_model_handover"));
+    assertTrue(operations.contains("stageSourceBundle"));
+    assertTrue(operations.contains("SourceProject.zip(project)"));
+    assertTrue(operations.contains("source_bundle"));
+  }
+
+  @Test public void unifiedComposerDoesNotStickToAnOldModelUnlessPinned() throws Exception {
+    String composer = Files.readString(Paths.get("src/main/java/com/ronin/vanta/UnifiedComposer.java"));
+    assertTrue(composer.contains("unified_pin_"));
+    assertTrue(composer.contains("task-fit now"));
+  }
+
+  @Test public void directBuildIsACompilerTaskNotAModelClaim() throws Exception {
+    assertEquals("build", UnifiedComposer.jobType(ComposerIntent.forAction("forge", "Android"), new org.json.JSONObject().put("compile_existing", true)));
+  }
+}
